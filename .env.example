# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Clerk — authentication (signup, login, passwords, sessions)
# Dashboard -> API keys: https://dashboard.clerk.com
# ---------------------------------------------------------------------------
# Copy the Publishable key and the Secret key from that page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Where Clerk sends people. The second one matters: a new account has no
# TeenTrade profile yet and must go through the age gate at /onboarding.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Only needed once you add a Clerk webhook (Dashboard -> Webhooks) pointing at
# /api/webhooks/clerk. It keeps the profile in step when someone changes their
# email or deletes their account. Everything else works without it.
CLERK_WEBHOOK_SECRET=your-clerk-webhook-signing-secret

# ---------------------------------------------------------------------------
# Supabase — the database
# Dashboard -> Project Settings -> API: https://supabase.com/dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row level security, so it
# must stay on the server: no NEXT_PUBLIC_ prefix, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
